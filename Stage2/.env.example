# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file. It is listed in .gitignore.

# Which LLM provider to use: claude, openai, or mock (mock needs no key)
LLM_PROVIDER=claude

# Model name. Haiku is a cheap, fast Claude model.
LLM_MODEL=claude-haiku-5-5

# Your personal API key goes in your local .env only, never in this file.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE